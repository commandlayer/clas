{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.commandlayer.org/schemas/v1.0.0/trust/certify/certify.request.schema.json",
  "title": "CLAS Trust Certify Request",
  "description": "A request to certify that a subject meets a defined standard, policy, or requirement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "family",
    "verb",
    "subject",
    "standard"
  ],
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "family": {
      "const": "trust"
    },
    "verb": {
      "const": "certify"
    },
    "context": {
      "type": "object",
      "additionalProperties": true
    },
    "subject": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-fA-F0-9]{64}$"
        }
      }
    },
    "standard": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
