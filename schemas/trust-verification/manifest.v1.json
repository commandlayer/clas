{
  "family": "trust-verification",
  "version": "1.0.0",
  "description": "Canonical trust verbs for interoperable machine-action verification, identity, assertions, approvals, signatures, and reputation vouchers.",
  "actions": [
    {
      "action": "verify",
      "namespace": "verifyagent.eth",
      "definition": "confirm claim against evidence",
      "status": "live"
    },
    {
      "action": "authenticate",
      "namespace": "authenticateagent.eth",
      "definition": "confirm identity and source",
      "status": "planned"
    },
    {
      "action": "attest",
      "namespace": "attestagent.eth",
      "definition": "signed assertion of truth",
      "status": "planned"
    },
    {
      "action": "certify",
      "namespace": "certifyagent.eth",
      "definition": "formal confirmation condition met",
      "status": "planned"
    },
    {
      "action": "notarize",
      "namespace": "notarizeagent.eth",
      "definition": "immutable timestamped witness record",
      "status": "planned"
    },
    {
      "action": "validate",
      "namespace": "validateagent.eth",
      "definition": "schema and rule conformance check",
      "status": "planned"
    },
    {
      "action": "witness",
      "namespace": "witnessagent.eth",
      "definition": "observed event record",
      "status": "planned"
    },
    {
      "action": "approve",
      "namespace": "approveagent.eth",
      "definition": "authorization to proceed",
      "status": "planned"
    },
    {
      "action": "sign",
      "namespace": "signagent.eth",
      "definition": "cryptographic commitment",
      "status": "planned"
    },
    {
      "action": "endorse",
      "namespace": "endorseagent.eth",
      "definition": "trust and reputation voucher",
      "status": "planned"
    }
  ],
  "receipt_required": true,
  "verification_required": true,
  "canonicalization": "json.sorted_keys.v1",
  "hash": "SHA-256",
  "signature_algorithm": "Ed25519",
  "network_agnostic": true
}
